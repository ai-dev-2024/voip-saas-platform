{
    "name": "@voip-saas/backend",
    "version": "1.0.0",
    "description": "VoIP SaaS Platform Backend API",
    "main": "src/index.js",
    "type": "module",
    "scripts": {
        "dev": "nodemon src/index.js",
        "start": "node src/index.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:watch": "npm test -- --watch",
        "test:integration": "npm test -- --testPathPattern=integration",
        "lint": "eslint src/",
        "db:migrate": "knex migrate:latest",
        "db:rollback": "knex migrate:rollback",
        "db:seed": "knex seed:run"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "knex": "^3.1.0",
        "pg": "^8.11.3",
        "redis": "^4.6.12",
        "stripe": "^14.10.0",
        "telnyx": "^2.2.0",
        "uuid": "^9.0.1",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "supertest": "^6.3.3"
    }
}
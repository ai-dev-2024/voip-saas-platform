# =================================
# VoIP SaaS Platform Configuration
# =================================

# Node Environment
NODE_ENV=development

# Server
PORT=3000
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# =================================
# Database (PostgreSQL)
# =================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/voip_saas

# =================================
# Redis (Caching & Sessions)
# =================================
REDIS_URL=redis://localhost:6379

# =================================
# Authentication (JWT)
# =================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# =================================
# Telnyx (VoIP Provider)
# =================================
# Get keys at: https://portal.telnyx.com
TELNYX_API_KEY=KEY_xxx
TELNYX_PUBLIC_KEY=KEY_xxx
TELNYX_SIP_CONNECTION_ID=xxx
TELNYX_WEBHOOK_SECRET=xxx

# =================================
# Stripe (Payments)
# =================================
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# =================================
# Security
# =================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
